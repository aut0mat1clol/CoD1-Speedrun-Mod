#include "ui/menudef.h"
{
menuDef
{
	name sr_settings
	fullScreen 0
	rect OPTIONS_WINDOW_POS OPTIONS_WINDOW_SIZE
	focusColor UI_FOCUS_COLOR
	soundloop ""
	onESC
	{
		open main;
		close options_menu;
	}
	itemDef { name sr_back rect 0 0 OPTIONS_WINDOW_SIZE style WINDOW_STYLE_FILLED border 1 bordercolor .5 .5 .5 .5 forecolor 1 1 1 1 backcolor OPTIONS_WINDOW_BACKCOLOR visible 1 decoration }
	itemDef { name header_back rect 80 2 200 32 style WINDOW_STYLE_FILLED border 0 backcolor OPTIONS_CONTROL_BACKCOLOR visible 1 decoration }
	itemDef { name sr_title1 text "Speedrun Mod" textscale .23 type ITEM_TYPE_BUTTON style 0 rect 112.5 5 120 10 textalign 1 textalignx 60 textaligny 10 forecolor 0.75 0.75 0.75 1 visible 1 decoration }
	itemDef { name sr_title2 text "Settings" type 1 textscale .23 rect 125 20 110 10 textalign 1 textalignx 55 textaligny 10 forecolor 1 1 1 .9 visible 1 decoration }
	itemDef
	{
		name sr_speedo
		type ITEM_TYPE_YESNO
		text "Speedometer:"
		cvar "sr_speedo"
		rect		5 38 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_spd_avg
		type ITEM_TYPE_YESNO
		text "Avg Speed:"
		cvar "sr_spd_avg"
		rect		5 52 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_igt
		type ITEM_TYPE_YESNO
		text "Timers:"
		cvar "sr_igt"
		rect		5 66 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_show_l
		type ITEM_TYPE_YESNO
		text "Show Level timer:"
		cvar "sr_show_l"
		rect		5 80 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_show_fg
		type ITEM_TYPE_YESNO
		text "Show Full Game:"
		cvar "sr_show_fg"
		rect		5 94 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_ilmode
		type ITEM_TYPE_YESNO
		text "IL mode (level only):"
		cvar "sr_ilmode"
		rect		5 108 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_tmr_dec
		type ITEM_TYPE_NUMERICFIELD
		text "Timer Decimals:"
		cvar "sr_tmr_dec"
		rect		5 122 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		maxChars 1
		mouseEnter { play "mouse_over" }

}

	itemDef
	{
		name sr_spd_dec
		type ITEM_TYPE_NUMERICFIELD
		text "Speed Decimals:"
		cvar "sr_spd_dec"
		rect		5 136 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		maxChars 1
		mouseEnter { play "mouse_over" }

}

	itemDef
	{
		name sr_lvl_start
		type ITEM_TYPE_YESNO
		text "L starts @ autosave:"
		cvar "sr_lvl_start"
		rect		5 150 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_debug
		type ITEM_TYPE_YESNO
		text "Debug:"
		cvar "sr_debug"
		rect		5 164 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef
	{
		name sr_runbtn
		type ITEM_TYPE_BUTTON
		text "Run Splits ..."
		rect		5 184 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { open sr_run; close sr_settings; play "mouse_click"; }

}

	itemDef
	{
		name sr_pbbtn
		type ITEM_TYPE_BUTTON
		text "Level PBs ..."
		rect		5 198 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { open sr_pb; close sr_settings; play "mouse_click"; }

}

	itemDef
	{
		name sr_delbtn
		type ITEM_TYPE_BUTTON
		text "Delete Runs ..."
		rect		5 212 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { open sr_delete; close sr_settings; play "mouse_click"; }

}

	itemDef
	{
		name sr_reset
		type ITEM_TYPE_BUTTON
		text "Reset Run"
		rect		5 234 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action
		{
			setcvar rt_run_total "0";
			setcvar rt_ms_cur "0";
			setcvar rt_spd_max "0";
			setcvar rt_end_frozen "0";
			setcvar rt_cont_real "0";
			setcvar rt_cont_wall "0";
			setcvar rt_cmd_mreset "1";
			setcvar rt_lat_prev "0";
			play "mouse_click";
		}

}

	itemDef { name sr_hint text "Decimals: 1=tenths 2=hundredths 3=ms" type ITEM_TYPE_TEXT textscale .15 rect 5 250 350 10 textalign ITEM_ALIGN_RIGHT textalignx OPTIONS_CONTROL_XALIGN forecolor 0.6 0.6 0.6 1 visible 1 decoration }
}
}
