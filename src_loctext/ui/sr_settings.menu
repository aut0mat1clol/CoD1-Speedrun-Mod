#include "ui/menudef.h"
{
menuDef 
{
	name sr_settings
	fullScreen 0				
	rect OPTIONS_WINDOW_POS OPTIONS_WINDOW_SIZE				
	focusColor UI_FOCUS_COLOR			
	soundloop ""
	onESC 
	{ 
		open main;
		close options_menu;		
	}
	itemDef 
	{
		name sr_back
		rect 0 0 OPTIONS_WINDOW_SIZE	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor OPTIONS_WINDOW_BACKCOLOR
		visible 1
		decoration
	}
	itemDef 
	{
		name header_back
		rect 80 2 200 32	
		style WINDOW_STYLE_FILLED
		border 0
		backcolor OPTIONS_CONTROL_BACKCOLOR
		visible 1
		decoration
	}
	itemDef 
	{
		name sr_title1
		text "Speedrun Mod"
		textscale .23
		type ITEM_TYPE_BUTTON
		style 0
		rect 112.5 5 120 10
		textalign 1
		textalignx 60
		textaligny 10
		forecolor 0.75 0.75 0.75 1
		visible 1
		decoration 
	}
	itemDef 
	{
		name sr_title2
		text "Settings"
		type 1
		textscale .23
		rect 125 20 110 10
		textalign 1
		textalignx 55
		textaligny 10
		forecolor 1 1 1 .9
		visible 1
		decoration
	}

	itemDef 
	{
		name sr_speedo
		type ITEM_TYPE_YESNO
		text "Speedometer:"
		cvar "sr_speedo"
		rect		5 40 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef 
	{
		name sr_spd_avg
		type ITEM_TYPE_YESNO
		text "Avg Speed:"
		cvar "sr_spd_avg"
		rect		5 55 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef 
	{
		name sr_igt
		type ITEM_TYPE_YESNO
		text "Timers:"
		cvar "sr_igt"
		rect		5 70 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef 
	{
		name sr_spd_dec
		type ITEM_TYPE_NUMERICFIELD
		text "Decimals:"
		cvar "sr_spd_dec"
		rect		5 85 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		maxChars 1
		mouseEnter { play "mouse_over" }

}

	itemDef 
	{
		name sr_debug
		type ITEM_TYPE_YESNO
		text "Debug:"
		cvar "sr_debug"
		rect		5 100 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action { play "mouse_click" }

}

	itemDef 
	{
		name sr_reset
		type ITEM_TYPE_BUTTON
		text "Reset Run"
		rect		5 124 OPTIONS_CONTROL_SIZE 
		textalign	ITEM_ALIGN_RIGHT
		textalignx	OPTIONS_CONTROL_XALIGN 
		textaligny	OPTIONS_CONTROL_YALIGN
		textscale	OPTIONS_CONTROL_TXTSCALE
		style		WINDOW_STYLE_FILLED
		backcolor	OPTIONS_CONTROL_BACKCOLOR
		forecolor	1 1 1 1
		visible 1
		mouseEnter { play "mouse_over" }
		action
		{
			setcvar rt_run_total "0";
			setcvar rt_ms_cur "0";
			setcvar rt_spd_max "0";
			setcvar rt_end_frozen "0";
			setcvar rt_cont_real "0";
			setcvar rt_cont_wall "0";
			setcvar rt_wtotal "0";
			setcvar rt_wcur_int "0";
			setcvar rt_cmd_mreset "1";
			play "mouse_click";
		}

}

} // end menuDef
} // end bracket